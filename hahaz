UserInputService.InputBegan:Connect(
    function(
        input,
        gameProcessed
    )

        if listeningForKey then

            if input.UserInputType ==
                Enum.UserInputType.Keyboard then

                tpKeybind =
                    input.KeyCode

                listeningForKey =
                    false

                KeybindBtn.Text =
                    "⌨  Teleport Home: ["
                    .. tpKeybind.Name
                    .. "]"

                KeybindBtn.TextColor3 =
                    Theme.Text2

            end

            return
        end

        if gameProcessed then
            return
        end

        if input.UserInputType ==
            Enum.UserInputType.Keyboard then

            if input.KeyCode ==
                tpKeybind then

                teleportToHomePlot()

            end
        end
    end
)

